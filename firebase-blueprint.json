{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private profile and personal budget alert settings for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name shown in workspace."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Private email address (PII, owner-only)."
        },
        "currency": {
          "type": "string",
          "enum": ["THB", "USD", "EUR", "JPY"],
          "description": "Preferred currency code."
        },
        "monthlyBudgetLimit": {
          "type": "number",
          "description": "Overall monthly spending ceiling."
        },
        "alertThresholdPercent": {
          "type": "number",
          "description": "Percentage threshold (50-100) for approaching-budget alerts."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether browser budget notifications are enabled."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "currency",
        "monthlyBudgetLimit",
        "alertThresholdPercent",
        "notificationsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense ledger entry belonging to a user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Short description of the transaction."
        },
        "amount": {
          "type": "number",
          "description": "Positive numeric transaction amount."
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Transaction direction."
        },
        "category": {
          "type": "string",
          "enum": [
            "salary",
            "freelance",
            "investment",
            "other_income",
            "food",
            "housing",
            "debt",
            "transport",
            "utilities",
            "health",
            "shopping",
            "entertainment",
            "education",
            "savings",
            "other_expense"
          ],
          "description": "Normalized transaction category key."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date in YYYY-MM-DD format."
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "description": "Year-month key YYYY-MM matching date."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "bank_transfer", "promptpay", "credit_card", "e_wallet"],
          "description": "Payment method used."
        },
        "note": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional memo or receipt note."
        },
        "allocationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Optional linked AnnualAllocation document ID."
        },
        "recurringId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Optional linked RecurringExpense document ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "amount",
        "type",
        "category",
        "date",
        "monthKey",
        "paymentMethod",
        "note",
        "allocationId",
        "recurringId",
        "createdAt",
        "updatedAt"
      ]
    },
    "CategoryBudget": {
      "title": "CategoryBudget",
      "description": "Per-category monthly spending ceiling and warning threshold.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "category": {
          "type": "string",
          "enum": [
            "food",
            "housing",
            "debt",
            "transport",
            "utilities",
            "health",
            "shopping",
            "entertainment",
            "education",
            "savings",
            "other_expense"
          ],
          "description": "Expense category governed by this budget."
        },
        "monthlyLimit": {
          "type": "number",
          "description": "Maximum planned monthly spend for this category."
        },
        "warningThreshold": {
          "type": "number",
          "description": "Alert percentage threshold (50-100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "category",
        "monthlyLimit",
        "warningThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "AnnualAllocation": {
      "title": "AnnualAllocation",
      "description": "Planned annual disbursement purpose such as dorm rent, debt repayment, tuition, or emergency fund.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Disbursement plan title."
        },
        "purpose": {
          "type": "string",
          "enum": [
            "dorm_rent",
            "debt_repayment",
            "education",
            "emergency_fund",
            "insurance_tax",
            "family_support",
            "investment_goal",
            "other_plan"
          ],
          "description": "Purpose category for annual financial overview."
        },
        "year": {
          "type": "number",
          "description": "Target calendar year (2020-2100)."
        },
        "targetAnnualAmount": {
          "type": "number",
          "description": "Total target disbursement for the year."
        },
        "monthlyPlannedAmount": {
          "type": "number",
          "description": "Planned monthly disbursement installment."
        },
        "disbursedAmount": {
          "type": "number",
          "description": "Cumulative amount disbursed so far."
        },
        "dueDay": {
          "type": "number",
          "description": "Scheduled day of month (1-31)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "completed"],
          "description": "Lifecycle state; completed is terminal."
        },
        "note": {
          "type": "string",
          "maxLength": 400,
          "description": "Notes or payment instructions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "purpose",
        "year",
        "targetAnnualAmount",
        "monthlyPlannedAmount",
        "disbursedAmount",
        "dueDay",
        "status",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecurringExpense": {
      "title": "RecurringExpense",
      "description": "Remembered recurring expense template for monthly/weekly/yearly obligations.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Name of recurring bill or subscription."
        },
        "amount": {
          "type": "number",
          "description": "Expected recurring charge amount."
        },
        "category": {
          "type": "string",
          "enum": [
            "food",
            "housing",
            "debt",
            "transport",
            "utilities",
            "health",
            "shopping",
            "entertainment",
            "education",
            "savings",
            "other_expense"
          ],
          "description": "Expense category."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "bank_transfer", "promptpay", "credit_card", "e_wallet"],
          "description": "Default payment method."
        },
        "frequency": {
          "type": "string",
          "enum": ["monthly", "weekly", "yearly"],
          "description": "Billing frequency."
        },
        "dueDay": {
          "type": "number",
          "description": "Due day of month (1-31)."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether reminders are active."
        },
        "lastLoggedMonth": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^$|^([0-9]{4}-[0-9]{2})$",
          "description": "Last YYYY-MM period when this recurring expense was posted to ledger."
        },
        "note": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional recurring memo."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "amount",
        "category",
        "paymentMethod",
        "frequency",
        "dueDay",
        "isActive",
        "lastLoggedMonth",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvestmentPosition": {
      "title": "InvestmentPosition",
      "description": "A user's gold, cryptocurrency, or stock investment holding valued against live market prices.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "assetType": {
          "type": "string",
          "enum": ["gold", "crypto", "stock"],
          "description": "Investment asset class."
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z0-9.=^\\-]+$",
          "description": "Normalized market ticker symbol."
        },
        "assetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the asset."
        },
        "investedAmount": {
          "type": "number",
          "description": "Principal capital invested in THB."
        },
        "entryPriceThb": {
          "type": "number",
          "description": "Unit market price in THB at purchase time."
        },
        "units": {
          "type": "number",
          "description": "Asset units acquired (investedAmount / entryPriceThb)."
        },
        "purchaseDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Purchase date in YYYY-MM-DD format."
        },
        "note": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional investment note."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "assetType",
        "symbol",
        "assetName",
        "investedAmount",
        "entryPriceThb",
        "units",
        "purchaseDate",
        "note",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile and global monthly budget alert configuration."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Owner-isolated income and expense transactions."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/CategoryBudget" },
      "description": "Owner-isolated per-category monthly budgets."
    },
    "/users/{userId}/allocations/{allocationId}": {
      "schema": { "$ref": "#/entities/AnnualAllocation" },
      "description": "Owner-isolated annual disbursement plans (debt, dorm rent, education, etc.)."
    },
    "/users/{userId}/recurring/{recurringId}": {
      "schema": { "$ref": "#/entities/RecurringExpense" },
      "description": "Owner-isolated remembered recurring expenses and subscriptions."
    },
    "/users/{userId}/investments/{investmentId}": {
      "schema": { "$ref": "#/entities/InvestmentPosition" },
      "description": "Owner-isolated gold, crypto, and stock investment holdings."
    }
  }
}
